{
  "name": "ago-calendar-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AGO Calendar's operator console - tenant setup and the shared pending-booking queue.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
