# Copy to .env.local (gitignored) and adjust. None of these are secrets - the OIDC client id is
# public by design (`adr/0023`'s console is a public client, no client secret; PKCE is what proves
# possession), the same status the widget's own tenant key has.

# Ago.Calendar.Api's own origin. 5011 rather than ago-chat's 5009: two products, two deployables,
# two ports (see the runbook).
VITE_API_BASE_URL=http://localhost:5011

# Must match Ago.Calendar.Api's own Operator:Authority *exactly* - issuer validation is a string
# comparison, and `5-05` records the 127.0.0.1-vs-localhost version of getting that wrong.
#
# The realm is AGO Chat's. That is deliberate and it is `adr/0027`'s own point: one identity
# provider across both products. What is *not* shared is what a token means afterwards - this
# console's tokens resolve against `ago-calendar`'s own `operators` table, through its own claims
# transformation, and a permission granted in AGO Chat's console grants nothing here.
VITE_KEYCLOAK_AUTHORITY=http://127.0.0.1:8081/realms/ago-chat

# Its own client, not `ago-console`'s. Two static bundles served from two origins need two
# redirect-URI allowlists, and sharing one client would mean either bundle could complete the
# other's login.
VITE_KEYCLOAK_CLIENT_ID=ago-calendar-console
